# Puerto del servidor
PORT=3000
# Carpeta con tu música (en Termux: /storage/emulated/0/Music)
MUSIC_DIR=/storage/emulated/0/Music
# Pon true si instalaste yt-dlp (pip install -U yt-dlp) para usar SoundCloud/YouTube
ENABLE_YTDLP=false
# Opcional: la dirección con la que lo abres desde fuera (ej. http://100.84.12.5:3000 de Tailscale)
PUBLIC_URL=
